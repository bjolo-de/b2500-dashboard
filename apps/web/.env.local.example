# Copy to .env.local and fill in real values.
# .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — bypasses RLS, used by /api/settings. Keep secret!
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Optional: keep secrets in 1Password instead of plain text. Put a secret
# reference here (e.g. SUPABASE_SERVICE_KEY=op://<vault>/<item>/credential)
# and start the app with `npm run dev:op`, which wraps Next.js in `op run`.
